---
/**
 * ProjectHero component - visual hero section for project detail pages
 * Displays project title, description, metadata, actions, and optional product showcase image
 */
import Icon from './Icon.astro';
import Button from './Button.astro';
import { formatDate, getDisplayTags } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: string;
  logo?: string;
  status: 'released' | 'in-progress';
  type?: 'own' | 'client';
  pubDate: Date;
  repository?: string;
  tags?: string[];
}

const { title, description, image, logo, status, type, pubDate, repository, tags } = Astro.props;

const formattedDate = formatDate(pubDate);

const displayTags = getDisplayTags(tags);
---

<section class="relative overflow-hidden bg-gradient-to-br from-off-white via-white to-off-white dark:from-near-black dark:via-near-black dark:to-near-black">
  {/* Background: decorative pattern */}
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    {/* Grid pattern: Uses olive-drab RGB (107,142,35) - update if brand color changes */}
    <div class="absolute inset-0 bg-[linear-gradient(rgba(107,142,35,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(107,142,35,0.03)_1px,transparent_1px)] dark:bg-[linear-gradient(rgba(107,142,35,0.08)_1px,transparent_1px),linear-gradient(90deg,rgba(107,142,35,0.08)_1px,transparent_1px)] bg-[size:60px_60px]" />

    {/* Gradient orbs */}
    <div class="absolute top-1/4 -left-32 w-64 h-64 bg-forest-green/5 dark:bg-forest-green/10 rounded-full blur-3xl" />
    <div class="absolute bottom-1/4 -right-32 w-80 h-80 bg-olive-drab/5 dark:bg-olive-drab/10 rounded-full blur-3xl" />

    {/* Decorative code elements */}
    <div class="absolute top-12 right-12 text-olive-drab/10 dark:text-olive-drab/20 text-4xl font-mono hidden lg:block">
      &lt;/&gt;
    </div>
  </div>

  {/* Content */}
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    {/* Back link */}
    <a
      href="/projects"
      class="inline-flex items-center gap-2 mb-8 text-sm font-medium transition-colors text-olive-drab hover:text-dark-olive dark:hover:text-white"
    >
      <Icon name="arrow-left" size="sm" />
      Back to Projects
    </a>

    {/* Logo + badges row */}
    {
      (logo || status === 'in-progress' || type === 'client') && (
        <div class="flex items-center gap-3 mb-4">
          {logo && (
            <img
              src={logo}
              alt=""
              class="w-10 h-10 rounded-lg"
              loading="eager"
            />
          )}
          {type === 'client' && (
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-full bg-sky-500/10 text-sky-600 dark:text-sky-400">
              <Icon name="briefcase" size="2xs" />
              Client Project
            </span>
          )}
          {status === 'in-progress' && (
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-full bg-olive-drab/10 text-olive-drab">
              <Icon name="clock" size="2xs" />
              In Progress
            </span>
          )}
        </div>
      )
    }

    {/* Title */}
    <h1
      class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-4 tracking-tight text-dark-olive dark:text-off-white"
    >
      {title}
    </h1>

    {/* Description */}
    <p
      class="text-lg sm:text-xl max-w-2xl mb-6 leading-relaxed text-near-black/80 dark:text-off-white/80"
    >
      {description}
    </p>

    {/* Date */}
    <div class="flex items-center gap-2 text-sm mb-6 text-olive-drab">
      <Icon name="calendar" size="sm" />
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </div>

    {/* Tech tags */}
    {
      displayTags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          {displayTags.map((tag) => (
            <span class="text-xs font-medium px-3 py-1.5 rounded-full border bg-off-white dark:bg-white/10 text-dark-olive/80 dark:text-off-white/80 border-olive-drab/10 dark:border-olive-drab/20">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    {/* Action buttons */}
    {
      repository && (
        <div class="flex flex-wrap gap-4">
          <Button href={repository} variant="primary" icon="github" external>
            View Repository
          </Button>
        </div>
      )
    }
  </div>

  {/* Product showcase image */}
  {
    image && (
      <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 sm:pb-16">
        <div class="rounded-xl overflow-hidden shadow-2xl shadow-near-black/20 dark:shadow-near-black/50 ring-1 ring-near-black/10 dark:ring-white/10">
          <img
            src={image}
            alt={`${title} product screenshot`}
            class="w-full h-auto"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    )
  }
</section>
