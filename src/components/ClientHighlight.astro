---
/**
 * ClientHighlight component - stats-forward showcase of key client partnership
 * Positioned between Services and Featured Projects on the homepage
 */
import Icon from './Icon.astro';
---

<section aria-labelledby="client-highlight-heading" class="py-16 sm:py-20">
  <div class="text-center mb-12">
    <h2
      id="client-highlight-heading"
      class="text-3xl sm:text-4xl font-bold text-dark-olive dark:text-off-white mb-4"
    >
      Trusted Partnership
    </h2>
    <p class="text-near-black/70 dark:text-off-white/70 max-w-2xl mx-auto text-lg">
      Embedded within the engineering organization at
      <strong class="text-dark-olive dark:text-off-white inline-flex items-center gap-1.5">
        <img src="/images/projects/text-logo.svg" alt="" class="inline w-5 h-5 rounded" />
        Text, Inc.</strong>
      &mdash; building AI-powered customer service products used by 35,000+ brands worldwide.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 lg:gap-8 max-w-3xl mx-auto mb-10">
    <div class="text-center p-6 rounded-xl bg-white dark:bg-near-black border border-olive-drab/10 dark:border-olive-drab/20">
      <div class="text-4xl sm:text-5xl font-bold text-forest-green mb-2">8+</div>
      <div class="text-sm text-near-black/70 dark:text-off-white/70 font-medium">Years</div>
    </div>
    <div class="text-center p-6 rounded-xl bg-white dark:bg-near-black border border-olive-drab/10 dark:border-olive-drab/20">
      <div class="text-4xl sm:text-5xl font-bold text-forest-green mb-2">3</div>
      <div class="text-sm text-near-black/70 dark:text-off-white/70 font-medium">Teams Managed</div>
    </div>
    <div class="text-center p-6 rounded-xl bg-white dark:bg-near-black border border-olive-drab/10 dark:border-olive-drab/20">
      <div class="text-4xl sm:text-5xl font-bold text-forest-green mb-2">35k+</div>
      <div class="text-sm text-near-black/70 dark:text-off-white/70 font-medium">Brands Served</div>
    </div>
  </div>

  <div class="text-center">
    <a
      href="/projects/text-inc"
      class="group inline-flex items-center gap-2 text-forest-green hover:text-dark-olive dark:hover:text-white font-medium transition-colors"
    >
      Read the full story
      <Icon name="arrow-right" size="sm" class="group-hover:translate-x-1 transition-transform" />
    </a>
  </div>
</section>
